<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Phase 2: Import / Krypto">
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Phase 2b: verschlüsselte Datenbank">
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <!-- SQLite3 Multiple Ciphers (offizielles Paket des Autors, SQLite 3.54.1 – behebt u. a. CVE-2025-6965), SQLCipher-v4-kompatibel -->
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.7.1" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup Label="Phase 3: UI">
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />

    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
</Project>
