<UserControl x:Class="HostDeck.App.Views.SessionPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Platzhalter bis Phase 4 (RDP-ActiveX / SSH-Terminal). Zeigt die aufgelösten Einstellungen –
         nützlich, um Import und Vererbung zu prüfen. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Padding="28,24" MinWidth="380" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{Binding Protocol, Converter={StaticResource ProtocolIcon}}" FontSize="36" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Connection.Path}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,3,16,3" />
                        </Style>
                    </Grid.Resources>
                    <TextBlock Grid.Row="0" Text="Protokoll" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Protocol}" />
                    <TextBlock Grid.Row="1" Text="Ziel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Endpoint}" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock Grid.Row="2" Text="Benutzer" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UserDisplay}" />
                    <TextBlock Grid.Row="3" Text="Credential-Vault" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Credentials.VaultEntry.Name, FallbackValue='–', TargetNullValue='–'}" />
                    <TextBlock Grid.Row="4" Text="RDP" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1">
                        <Run Text="{Binding Settings.Rdp.ResolutionMode, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Settings.Rdp.ColorDepth, Mode=OneWay}" /><Run Text=" · Gateway: " /><Run Text="{Binding Settings.Rdp.Gateway.Usage, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="5" Text="Passwort" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="PasswordState" />
                </Grid>

                <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" MaxWidth="420" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Die Protokoll-Engine (RDP / SSH + SFTP) folgt in Phase 4. Hier erscheint dann die eingebettete Session." />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
