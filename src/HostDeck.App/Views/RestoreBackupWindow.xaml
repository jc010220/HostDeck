<ui:FluentWindow x:Class="HostDeck.App.Views.RestoreBackupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Restore personal backup" Width="560" Height="480" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
                 ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <DockPanel Margin="0,0,0,16">
        <ui:TitleBar DockPanel.Dock="Top" Title="Restore personal backup" ShowMinimize="False" ShowMaximize="False" />
        <TextBlock DockPanel.Dock="Top" Margin="24,0,24,8" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Choose a personal backup. HostDeck checks it first (you may be asked for the master password valid at backup time), saves the current state as a backup and then restarts with the restored data. The team library is synchronized again afterwards." />
        <DockPanel DockPanel.Dock="Bottom" Margin="24,12,24,0">
            <ui:Button DockPanel.Dock="Left" Content="Other file …" Click="OnBrowse" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <ui:Button x:Name="RestoreButton" Content="Restore" Appearance="Primary" MinWidth="96" IsEnabled="False" Click="OnRestore" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="24,8" Visibility="Collapsed" TextWrapping="Wrap"
                   Text="No backups found in the backup folder. Use “Other file …” to pick a backup elsewhere." />
        <Border Margin="24,0" CornerRadius="6" BorderThickness="1" Padding="2"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ListBox x:Name="BackupList" Background="Transparent" BorderThickness="0" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Display}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</ui:FluentWindow>
