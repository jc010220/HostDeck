<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Für das RDP-ActiveX-Control (AxHost) -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 gilt für reine WinForms-Apps; in WPF wird PerMonitorV2 korrekt über app.manifest gesetzt -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>HostDeck.App</RootNamespace>
    <AssemblyName>HostDeck</AssemblyName>
    <!-- Eigener Einstiegspunkt: Velopack muss vor WPF laufen (Install-/Update-Hooks) -->
    <StartupObject>HostDeck.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hostdeck.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HostDeck.Presentation\HostDeck.Presentation.csproj" />
    <ProjectReference Include="..\HostDeck.Storage\HostDeck.Storage.csproj" />
    <ProjectReference Include="..\HostDeck.Protocols.Rdp\HostDeck.Protocols.Rdp.csproj" />
    <ProjectReference Include="..\HostDeck.Protocols.Vnc\HostDeck.Protocols.Vnc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms nur gezielt im RDP-Code verwenden, keine globalen Namenskonflikte mit WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\hostdeck.ico" />
    <!-- Terminal (xterm.js, MIT) als eingebettete Ressource: funktioniert auch in der Single-File-EXE -->
    <EmbeddedResource Include="Assets\Terminal\*" LogicalName="terminal/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
