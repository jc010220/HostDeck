<ui:FluentWindow x:Class="HostDeck.App.Views.MessageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="560" SizeToContent="Height" MaxHeight="640"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" ShowInTaskbar="False">
    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False" />
        <ScrollViewer Grid.Row="1" Margin="24,8,24,16" VerticalScrollBarVisibility="Auto" MaxHeight="480">
            <TextBox x:Name="MessageText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                     Background="Transparent" />
        </ScrollViewer>
        <ui:Button Grid.Row="2" Content="OK" Appearance="Primary" IsDefault="True" IsCancel="True"
                   HorizontalAlignment="Right" Margin="0,0,24,0" MinWidth="96" Click="OnOk" />
    </Grid>
</ui:FluentWindow>
