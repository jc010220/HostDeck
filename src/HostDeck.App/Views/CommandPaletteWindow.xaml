<Window x:Class="HostDeck.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:HostDeck.App"
        Width="680" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="Manual"
        UseLayoutRounding="True" Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Border Margin="12" CornerRadius="10" BorderThickness="1" Padding="10"
            Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>
            <ui:TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="16"
                        PlaceholderText="Find device (name, IP, folder, tag) · ssh user@host · &gt; commands">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Search}" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Margin="0,8,0,0"
                     MaxHeight="440" BorderThickness="0" Background="Transparent" MouseUp="OnResultClicked"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,3">
                            <ui:SymbolIcon DockPanel.Dock="Left" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                                           Symbol="{Binding Protocol, Converter={StaticResource ProtocolIcon}}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="★" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Favorite"
                                       Foreground="#F7B500" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock DockPanel.Dock="Right" Text="↺" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Recently used"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding IsRecent, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Margin="4,8,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Enter connect · Ctrl+Enter in split view · Alt+Enter show in tree · ↑↓ select · Esc close" />
        </StackPanel>
    </Border>
</Window>
