<ui:FluentWindow x:Class="HostDeck.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:HostDeck.App"
                 Title="Settings" Width="900" Height="640" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
                 ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <DockPanel Margin="0,0,0,16">
        <ui:TitleBar DockPanel.Dock="Top" Title="Settings" ShowMinimize="False" ShowMaximize="False" />
        <!-- Fußzeile: Version + Speichern -->
            <DockPanel DockPanel.Dock="Bottom" Margin="24,12,24,0">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="HostDeck " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <ui:Button Content="Save" Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOk" />
                </StackPanel>
            </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Navigation (Hamburger klappt auf Symbole zusammen) -->
            <DockPanel Margin="8,0,0,0">
                <ui:Button DockPanel.Dock="Top" Appearance="Transparent" Padding="10,6" HorizontalAlignment="Left" Click="OnToggleNav"
                           ToolTip="Show/hide menu labels" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Menu}" />
                </ui:Button>
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="OnNavChanged">
                    <ListBoxItem Tag="SecAppearance"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{x:Static app:Icons.Appearance}" Margin="0,0,12,0" /><TextBlock Text="Appearance" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="SecBehavior"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{x:Static app:Icons.Behavior}" Margin="0,0,12,0" /><TextBlock Text="Behavior" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="SecTeam"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{x:Static app:Icons.Team}" Margin="0,0,12,0" /><TextBlock Text="Libraries" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="SecBackups"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{x:Static app:Icons.History}" Margin="0,0,12,0" /><TextBlock Text="Personal backups" /></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="SecUpdates"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{x:Static app:Icons.Download}" Margin="0,0,12,0" /><TextBlock Text="Updates" /></StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,4,24,0">
            <StackPanel x:Name="SecAppearance" Visibility="Visible">
                <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Terminal font size" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" />
            </Grid>
            <CheckBox Content="Syntax highlighting in the terminal (errors, warnings, IPs)" IsChecked="{Binding Highlighting}" Margin="0,4,0,0" />
            <CheckBox Content="Online status in the tree (TCP check of visible connections)" IsChecked="{Binding ShowReachability}" Margin="0,4,0,0" />

            </StackPanel>
            <StackPanel x:Name="SecBehavior" Visibility="Collapsed">
                <TextBlock Text="Behavior" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Lock automatically" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AutoLockOptions}" SelectedItem="{Binding AutoLock}" DisplayMemberPath="Label"
                          ToolTip="Hide all HostDeck windows after this time without keyboard/mouse input; unlock with the master password. Sessions keep running." />
            </Grid>
            <CheckBox Content="Lock when Windows is locked (Win+L)" IsChecked="{Binding LockWithWindows}" Margin="0,4,0,8" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Quick connect default protocol" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Protocols}" SelectedItem="{Binding DefaultProtocol}" ItemTemplate="{StaticResource EnumDisplayTemplate}" />
            </Grid>
            <CheckBox Content="Restore open sessions on startup" IsChecked="{Binding RestoreWorkspace}" Margin="0,4,0,0" />
            <CheckBox Content="SFTP browser follows the terminal directory" IsChecked="{Binding SftpFollows}" Margin="0,4,0,0" />
            <CheckBox Content="Ask before pasting with right-click in the terminal" IsChecked="{Binding ConfirmRightClickPaste}" Margin="0,4,0,0"
                      ToolTip="Prevents accidental pastes. Multi-line text always asks; Ctrl+Shift+V pastes single lines directly." />
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="mRemoteNG import: credentials" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ExtractionModes}" SelectedItem="{Binding CredentialExtraction}" ItemTemplate="{StaticResource EnumDisplayTemplate}"
                          ToolTip="How logins from imported mRemoteNG files are stored" />
            </Grid>

            </StackPanel>
            <StackPanel x:Name="SecTeam" Visibility="Collapsed">
                <TextBlock Text="Libraries" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Margin="0,0,0,8" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Each library is a confCons.xml (stays compatible with mRemoteNG) and appears as its own folder in the tree – e.g. one per team, or your own file on OneDrive. Changes by others appear automatically, save your own with Ctrl+S. Folder instead of file: the newest .xml in it is used. A file that does not exist yet is created when you click OK." />
            <ItemsControl ItemsSource="{Binding Libraries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" /><ColumnDefinition Width="8" /><ColumnDefinition />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Folder name" ToolTip="Name of the folder in your tree" />
                            <ui:TextBox Grid.Column="2" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="\\server\team\confCons.xml  ·  OneDrive\HostDeck\confCons.xml" />
                            <ui:Button Grid.Column="3" Content="Browse …" Margin="8,0,0,0" CommandParameter="{Binding}"
                                       Command="{Binding DataContext.BrowseLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ui:Button Grid.Column="4" Margin="6,0,0,0" ToolTip="Disconnect this library (the file itself is not changed)" CommandParameter="{Binding}"
                                       Command="{Binding DataContext.RemoveLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button>
                            <CheckBox Grid.Row="1" Grid.Column="2" Content="Read-only (e.g. jump host with a local copy)" IsChecked="{Binding ReadOnly}" Margin="0,4,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button Content="Add library …" Command="{Binding AddLibraryCommand}" HorizontalAlignment="Left" Margin="0,2,0,0" />


            <TextBlock Text="Library backups" FontWeight="SemiBold" Margin="0,20,0,2" />
            <TextBlock Margin="0,0,0,6" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Daily copies of the library file (and its snippets) in the folder “HostDeck-Backups” next to it, with subfolders daily / weekly / monthly. The rule applies to everyone using that file and is stored in that folder; the first person who opens HostDeck each day creates the backup." />
            <StackPanel IsEnabled="{Binding TeamBackupAvailable}">
                <Grid Margin="0,0,0,8" Visibility="{Binding HasSeveralTeamFiles, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="Library" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding TeamFiles}" SelectedItem="{Binding SelectedTeamFile}" DisplayMemberPath="Name" />
                </Grid>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Open folder" Margin="0,0,6,0" Click="OnOpenTeamBackupFolder" />
                        <ui:Button Content="Back up now" Click="OnTeamBackupNow" />
                    </StackPanel>
                    <ui:ToggleSwitch Content="Back up this library automatically (daily)" IsChecked="{Binding TeamBackupEnabled}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" /><ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" /><ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Keep daily" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DailyOptions}" SelectedItem="{Binding TeamKeepDaily}" />
                    <TextBlock Grid.Column="3" Text="weekly" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding WeeklyOptions}" SelectedItem="{Binding TeamKeepWeekly}" />
                    <TextBlock Grid.Column="6" Text="monthly" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="7" ItemsSource="{Binding MonthlyOptions}" SelectedItem="{Binding TeamKeepMonthly}" />
                </Grid>
            </StackPanel>
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding TeamBackupSummary}" />
            </StackPanel>
            <StackPanel x:Name="SecBackups" Visibility="Collapsed">
                <TextBlock Text="Personal backups" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Margin="0,0,0,6" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Your own HostDeck database: personal folders and connections, vault, personal snippets and settings for team entries. The team library keeps its own version history (last 10 versions before each save)." />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Restore …" Margin="0,0,6,0" Click="OnRestoreBackup" />
                    <ui:Button Content="Open folder" Margin="0,0,6,0" Click="OnOpenBackupFolder" />
                    <ui:Button Content="Back up now" Click="OnBackupNow" />
                </StackPanel>
                <ui:ToggleSwitch Content="Create personal backups automatically (daily)" IsChecked="{Binding AutoBackup}" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <ui:Button DockPanel.Dock="Right" Content="Browse …" Margin="8,0,0,0" Click="OnBrowseBackupFolder" />
                <ui:TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding BackupFolderHint}" />
            </DockPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" /><ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" /><ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Keep daily" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DailyOptions}" SelectedItem="{Binding KeepDaily}" />
                <TextBlock Grid.Column="3" Text="weekly" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding WeeklyOptions}" SelectedItem="{Binding KeepWeekly}" />
                <TextBlock Grid.Column="6" Text="monthly" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="7" ItemsSource="{Binding MonthlyOptions}" SelectedItem="{Binding KeepMonthly}" />
            </Grid>
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="Grandfather-father-son retention: HostDeck keeps the newest backup of each of the last days, weeks and months shown above and deletes older automatic backups. The newest backup is always kept. Backups are encrypted copies (database + key file) and open with the master password valid at backup time. Tip: choose a folder on another drive, a network share or OneDrive. " />
                <Run Text="{Binding BackupSummary, Mode=OneWay}" />
            </TextBlock>

            </StackPanel>
            <StackPanel x:Name="SecUpdates" Visibility="Collapsed">
                <TextBlock Text="Updates" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Check for updates now" Click="OnCheckForUpdates" VerticalAlignment="Center" />
                <ui:ToggleSwitch Content="Install updates automatically" IsChecked="{Binding AutoUpdate}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="When on, HostDeck checks once a day, downloads new versions in the background and installs them when you close the app – never during a session. " />
                <Run Text="{Binding LastUpdateCheckText, Mode=OneWay}" />
            </TextBlock>
            <Expander Header="Advanced: update source and access token" Margin="0,8,0,0">
                <StackPanel Margin="0,6,0,0">
                    <ui:TextBox Text="{Binding UpdateSource, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="https://github.com/…  ·  \\server\software\HostDeck  ·  https://…" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Default: the HostDeck GitHub repository. A network share or HTTPS folder with the release files works as well." />
                    <ui:PasswordBox x:Name="TokenBox" Margin="0,8,0,0" PlaceholderText="{Binding UpdateTokenHint}" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Only for a private GitHub repository: GitHub → Settings → Developer settings → Fine-grained tokens, only this repository, permission “Contents: Read-only”. Stored encrypted in the HostDeck database." />
                </StackPanel>
            </Expander>

            </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
