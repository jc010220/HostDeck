<ui:FluentWindow x:Class="HostDeck.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel Margin="0,0,0,20">
        <ui:TitleBar Title="Settings" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,4,24,0">
            <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Terminal font size" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" />
            </Grid>
            <CheckBox Content="Syntax highlighting in the terminal (errors, warnings, IPs)" IsChecked="{Binding Highlighting}" Margin="0,4,0,0" />
            <CheckBox Content="Online status in the tree (TCP check of visible connections)" IsChecked="{Binding ShowReachability}" Margin="0,4,0,0" />

            <TextBlock Text="Behavior" FontWeight="SemiBold" Margin="0,16,0,6" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Quick connect default protocol" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Protocols}" SelectedItem="{Binding DefaultProtocol}" ItemTemplate="{StaticResource EnumDisplayTemplate}" />
            </Grid>
            <CheckBox Content="Restore open sessions on startup" IsChecked="{Binding RestoreWorkspace}" Margin="0,4,0,0" />
            <CheckBox Content="SFTP browser follows the terminal directory" IsChecked="{Binding SftpFollows}" Margin="0,4,0,0" />
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="mRemoteNG import: credentials" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ExtractionModes}" SelectedItem="{Binding CredentialExtraction}" ItemTemplate="{StaticResource EnumDisplayTemplate}"
                          ToolTip="How logins from imported mRemoteNG files are stored" />
            </Grid>

            <TextBlock Text="Team library" FontWeight="SemiBold" Margin="0,16,0,6" />
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Browse …" Margin="8,0,0,0" Click="OnBrowseTeamLibrary" />
                <ui:TextBox Text="{Binding TeamLibraryPath, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="\\server\team\confCons.xml  ·  Jumphost: C:\HostDeck\Team" />
            </DockPanel>
            <CheckBox Content="Read-only (e.g. jump host with a local copy)" IsChecked="{Binding TeamReadOnly}" Margin="0,6,0,0" />
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Shared confCons.xml (stays compatible with mRemoteNG). Changes by others appear automatically, save your own with Ctrl+S. Folder instead of file: the newest .xml in it is used." />

            <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,16,0,6" />
            <ui:TextBox Text="{Binding UpdateSource, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="\\server\software\HostDeck  ·  https://…  ·  https://github.com/…" />
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Updates are downloaded in the background and installed on exit (only when installed via Setup.exe)." />
            <ui:PasswordBox x:Name="TokenBox" Margin="0,8,0,0" PlaceholderText="{Binding UpdateTokenHint}" />
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="GitHub → Settings → Developer settings → Fine-grained tokens: only this repository, permission “Contents: Read-only”. Stored encrypted in the HostDeck database." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <ui:Button Content="Save" Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
