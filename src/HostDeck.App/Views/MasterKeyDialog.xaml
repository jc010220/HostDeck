<ui:FluentWindow x:Class="HostDeck.App.Views.MasterKeyDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:HostDeck.App"
                 Title="HostDeck" Width="460" SizeToContent="Height"
                 WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel Margin="0,0,0,20">
        <ui:TitleBar x:Name="TitleBar" Title="HostDeck" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="28,4,28,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:SymbolIcon Symbol="{x:Static app:Icons.Lock}" FontSize="32" Margin="0,0,14,0" />
                <StackPanel>
                    <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="Info" TextWrapping="Wrap" MaxWidth="330" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="CurrentPanel">
                <TextBlock Text="Current master password" Margin="0,0,0,4" />
                <PasswordBox x:Name="CurrentInput" Margin="0,0,0,10" />
            </StackPanel>
            <TextBlock x:Name="NewLabel" Text="Master password" Margin="0,0,0,4" />
            <PasswordBox x:Name="NewInput" Margin="0,0,0,10" PasswordChanged="OnPasswordChanged" />
            <StackPanel x:Name="ConfirmPanel">
                <TextBlock Text="Repeat" Margin="0,0,0,4" />
                <PasswordBox x:Name="ConfirmInput" Margin="0,0,0,6" PasswordChanged="OnPasswordChanged" />
                <TextBlock x:Name="StrengthText" FontSize="11" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <CheckBox x:Name="RememberBox" Content="Remember on this PC (Windows account, no password needed)" Margin="0,4,0,8" />
            <TextBlock x:Name="ErrorText" Foreground="#E81123" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

            <DockPanel Margin="0,8,0,0">
                <ui:HyperlinkButton x:Name="ForgotButton" Content="Forgot password?" Padding="0" Click="OnForgot" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <ui:Button x:Name="OkButton" Appearance="Primary" IsDefault="True" MinWidth="110" Click="OnOk" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
