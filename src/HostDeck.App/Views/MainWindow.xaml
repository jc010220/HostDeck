<ui:FluentWindow x:Class="HostDeck.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:HostDeck.App"
                 xmlns:views="clr-namespace:HostDeck.App.Views"
                 xmlns:vm="clr-namespace:HostDeck.Presentation.ViewModels;assembly=HostDeck.Presentation"
                 xmlns:behaviors="clr-namespace:HostDeck.App.Behaviors"
                 Title="HostDeck" Width="1440" Height="900" MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="HostDeck">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/hostdeck.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="1" Padding="8,2,8,6">
            <DockPanel LastChildFill="False">
                <DockPanel.Resources>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Appearance" Value="Transparent" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                    </Style>
                    <Style TargetType="Separator">
                        <Setter Property="Margin" Value="6,4" />
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DockPanel.Resources>

                <ui:Button Command="{Binding ImportMRemoteNGCommand}" ToolTip="mRemoteNG-Datei (confCons.xml) importieren  (Strg+O)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{x:Static app:Icons.Import}" Margin="0,0,6,0" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Command="{Binding ExportMRemoteNGCommand}" ToolTip="Als mRemoteNG-Datei exportieren">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Export}" />
                </ui:Button>
                <Separator />
                <ui:Button Command="{Binding NewConnectionCommand}" ToolTip="Neue Verbindung  (Strg+N)">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Add}" />
                </ui:Button>
                <ui:Button Command="{Binding NewFolderCommand}" ToolTip="Neuer Ordner  (Strg+Umschalt+N)">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.FolderAdd}" />
                </ui:Button>
                <Separator />

                <!-- Split-Screen -->
                <ToggleButton ToolTip="Ein Bereich  (Strg+Alt+1)" Command="{Binding Workspace.SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.Single}"
                              IsChecked="{Binding Workspace.Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Single}">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.LayoutSingle}" />
                </ToggleButton>
                <ToggleButton ToolTip="Zwei Bereiche nebeneinander  (Strg+Alt+2)" Command="{Binding Workspace.SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.TwoColumns}"
                              IsChecked="{Binding Workspace.Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=TwoColumns}">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.LayoutColumns}" />
                </ToggleButton>
                <ToggleButton ToolTip="Zwei Bereiche untereinander  (Strg+Alt+3)" Command="{Binding Workspace.SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.TwoRows}"
                              IsChecked="{Binding Workspace.Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=TwoRows}">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.LayoutRows}" />
                </ToggleButton>
                <ToggleButton ToolTip="4er-Grid  (Strg+Alt+4)" Command="{Binding Workspace.SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.Grid}"
                              IsChecked="{Binding Workspace.Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Grid}">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.LayoutGrid}" />
                </ToggleButton>
                <Separator />
                <ToggleButton IsChecked="{Binding IsMultiExecutionEnabled}"
                              ToolTip="Multi-Execution: Eingaben an alle Terminal-Tabs senden  (Strg+Umschalt+M)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{x:Static app:Icons.Keyboard}" Margin="0,0,6,0" />
                        <TextBlock Text="Multi-Exec" />
                    </StackPanel>
                </ToggleButton>

                <ui:Button DockPanel.Dock="Right" Click="OnPaletteButton" ToolTip="Schnellsuche  (Strg+K)" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{x:Static app:Icons.Search}" Margin="0,0,6,0" />
                        <TextBlock Text="Suchen …" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Margin="10,0,0,0" Padding="5,0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <TextBlock Text="Strg+K" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Border>
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" ToolTip="Sicherheit" Click="OnSecurityMenu">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Lock}" />
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Zugangsdaten verwalten (Vault) …" Command="{Binding ManageVaultCommand}" />
                            <MenuItem Header="Master-Passwort ändern …" Command="{Binding ChangeMasterPasswordCommand}" />
                            <MenuItem Header="Auf diesem PC merken (ohne Passwort entsperren)" IsCheckable="True"
                                      IsChecked="{Binding IsDeviceUnlockEnabled}"
                                      Visibility="{Binding DeviceUnlockSupported, Converter={StaticResource BoolToVisibility}}" />
                            <Separator />
                            <MenuItem Header="{Binding StoreLocation}" HeaderStringFormat="Datenbank: {0}" IsEnabled="False" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Command="{Binding ToggleThemeCommand}" ToolTip="Hell / Dunkel umschalten">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Moon}" />
                </ui:Button>
            </DockPanel>
        </Border>

        <!-- ===== Hauptbereich ===== -->
        <Grid Grid.Row="2" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="200" MaxWidth="700" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Seitenleiste -->
            <Border CornerRadius="6" Padding="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
              <TabControl x:Name="SidebarTabs" Background="Transparent" BorderThickness="0" Padding="0,6,0,0">
                <TabItem Header="Sitzungen">
                <DockPanel>
                    <ComboBox x:Name="QuickConnectBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,6"
                              Text="{Binding QuickConnectText, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding QuickConnectHistory}" PreviewKeyDown="OnQuickConnectKeyDown"
                              ToolTip="Quick-Connect: ssh user@host:22 · rdp server · mstsc /v:host · telnet host 23 · Name aus der Liste  (Strg+L)" />

                    <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6" PlaceholderText="Suchen …  (Strg+F)"
                                Text="{Binding SessionTree.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                ClearButtonEnabled="True" PreviewKeyDown="OnSearchKeyDown">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="{x:Static app:Icons.Search}" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <TextBlock DockPanel.Dock="Bottom" Margin="4,6,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <Run Text="{Binding SessionTree.VisibleConnectionCount, Mode=OneWay}" /><Run Text=" Verbindungen" />
                    </TextBlock>

                    <TreeView x:Name="SessionTreeView" ItemsSource="{Binding SessionTree.Items}"
                              behaviors:TreeDragDrop.ViewModel="{Binding SessionTree}"
                              SelectedItemChanged="OnTreeSelectedItemChanged" MouseDoubleClick="OnTreeDoubleClick"
                              KeyDown="OnTreeKeyDown" Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                                <Setter Property="ToolTip" Value="{Binding Subtitle}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Verbinden" InputGestureText="Enter" Click="OnMenuOpen" FontWeight="SemiBold" />
                                <MenuItem Header="Alle im Split-Screen öffnen" Click="OnMenuOpenTiled" />
                                <Separator />
                                <MenuItem Header="Neue Verbindung" InputGestureText="Strg+N" Command="{Binding NewConnectionCommand}" />
                                <MenuItem Header="Neuer Ordner" InputGestureText="Strg+Umschalt+N" Command="{Binding NewFolderCommand}" />
                                <Separator />
                                <MenuItem Header="Eigenschaften …" InputGestureText="F4" Click="OnMenuEdit" />
                                <MenuItem Header="Umbenennen" InputGestureText="F2" Click="OnMenuRename" />
                                <MenuItem Header="Löschen" InputGestureText="Entf" Click="OnMenuDelete" />
                                <Separator />
                                <MenuItem Header="Zugangsdaten verwalten (Vault) …" Command="{Binding ManageVaultCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <ui:SymbolIcon FontSize="16" Margin="0,0,8,0">
                                        <ui:SymbolIcon.Symbol>
                                            <MultiBinding Converter="{StaticResource ProtocolIcon}">
                                                <Binding />
                                                <Binding Path="IsExpanded" />
                                                <Binding Path="Protocol" />
                                            </MultiBinding>
                                        </ui:SymbolIcon.Symbol>
                                    </ui:SymbolIcon>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
                </TabItem>

                <!-- ===== SFTP-Browser des aktiven SSH-Tabs ===== -->
                <TabItem Header="SFTP">
                    <Grid>
                        <TextBlock Margin="8,24" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Öffne eine SSH-Session – der Dateibrowser folgt dann automatisch dem Verzeichnis im Terminal."
                                   Visibility="{Binding ActiveSftp, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                        <DockPanel DataContext="{Binding ActiveSftp}"
                                   Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <ui:Button DockPanel.Dock="Left" Appearance="Transparent" Padding="6,4" Command="{Binding UpCommand}" ToolTip="Übergeordneter Ordner">
                                    <ui:SymbolIcon Symbol="{x:Static app:Icons.ArrowUp}" />
                                </ui:Button>
                                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="6,4" Command="{Binding RefreshCommand}" ToolTip="Aktualisieren">
                                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Refresh}" />
                                </ui:Button>
                                <TextBox x:Name="SftpPath" Text="{Binding Path, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         KeyDown="OnSftpPathKeyDown" ToolTip="Pfad eingeben und Enter drücken" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                                <CheckBox Content="Terminal folgen" IsChecked="{Binding FollowTerminal}" ToolTip="Ordner wechselt mit „cd“ im Terminal" />
                                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="6,4" Command="{Binding NewFolderCommand}" ToolTip="Neuer Ordner">
                                    <ui:SymbolIcon Symbol="{x:Static app:Icons.FolderAdd}" />
                                </ui:Button>
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="2,6,0,0">
                                <ProgressBar Height="3" Value="{Binding TransferPercent}" Margin="0,0,0,4"
                                             Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ListView x:Name="SftpList" ItemsSource="{Binding Entries}" SelectionMode="Extended" AllowDrop="True"
                                      MouseDoubleClick="OnSftpDoubleClick" Drop="OnSftpDrop" DragOver="OnSftpDragOver"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding Permissions}">
                                            <ui:SymbolIcon DockPanel.Dock="Left" FontSize="16" Margin="0,0,8,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="{x:Static app:Icons.Document}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Symbol" Value="{x:Static app:Icons.Folder}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Size, Converter={StaticResource FileSize}}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Öffnen / Herunterladen (Downloads)" Click="OnSftpOpen" FontWeight="SemiBold" />
                                        <MenuItem Header="Herunterladen nach …" Click="OnSftpDownload" />
                                        <MenuItem Header="Umbenennen" Click="OnSftpRename" />
                                        <MenuItem Header="Löschen" Click="OnSftpDelete" />
                                        <Separator />
                                        <MenuItem Header="Dateien hochladen …" Click="OnSftpUpload" />
                                        <MenuItem Header="Neuer Ordner" Command="{Binding NewFolderCommand}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                        </DockPanel>
                    </Grid>
                </TabItem>
                <!-- ===== Snippets / Makros ===== -->
                <TabItem Header="Snippets">
                    <DockPanel DataContext="{Binding Snippets}">
                        <ui:TextBox DockPanel.Dock="Top" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Snippets filtern …" Margin="0,0,0,6" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:Button Click="OnSnippetAdd" Appearance="Transparent" Padding="6,4" ToolTip="Neues Snippet">
                                <ui:SymbolIcon Symbol="{x:Static app:Icons.Add}" />
                            </ui:Button>
                            <ui:Button Click="OnSnippetEdit" Appearance="Transparent" Padding="6,4" ToolTip="Bearbeiten">
                                <ui:SymbolIcon Symbol="{x:Static app:Icons.Edit}" />
                            </ui:Button>
                            <ui:Button Click="OnSnippetDelete" Appearance="Transparent" Padding="6,4" ToolTip="Löschen">
                                <ui:SymbolIcon Symbol="{x:Static app:Icons.Delete}" />
                            </ui:Button>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" MaxWidth="170"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Doppelklick sendet an das aktive Terminal (Multi-Exec: an alle)" />
                        </StackPanel>
                        <ListBox x:Name="SnippetList" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}"
                                 MouseDoubleClick="OnSnippetRun" KeyDown="OnSnippetKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2" ToolTip="{Binding Command}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontSize="10" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Command}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
              </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                          DragCompleted="OnSidebarResized" />

            <!-- Arbeitsbereich: Tabs + Split-Screen -->
            <views:SplitWorkspace x:Name="Workspace" Grid.Column="2" Workspace="{Binding Workspace}" />
        </Grid>

        <!-- ===== Statusleiste ===== -->
        <DockPanel Grid.Row="3" Margin="12,4,12,6">
            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{Binding Workspace.TabCount, Mode=OneWay}" /><Run Text=" Session(s)" />
            </TextBlock>
            <Border DockPanel.Dock="Right" Margin="0,0,12,0" Padding="8,0" CornerRadius="4"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="{Binding IsMultiExecutionEnabled, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="MULTI-EXEC AKTIV" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
