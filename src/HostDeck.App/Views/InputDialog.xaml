<ui:FluentWindow x:Class="HostDeck.App.Views.InputDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel Margin="0,0,0,20">
        <ui:TitleBar x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,4,24,0">
            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBox x:Name="ValueInput" Margin="0,0,0,12" />
            <PasswordBox x:Name="SecretInput" Margin="0,0,0,12" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Abbrechen" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <ui:Button Content="OK" Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
