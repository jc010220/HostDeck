<ui:FluentWindow x:Class="HostDeck.App.Views.ConnectionEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Eigenschaften" Width="640" Height="660" MinHeight="480"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="IsThreeState" Value="True" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="ToolTip" Value="Drei Zustände: an / aus / ■ geerbt" />
        </Style>
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Eigenschaften" ShowMinimize="False" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="24,0,24,4" TextTrimming="CharacterEllipsis" />
        <TextBlock DockPanel.Dock="Top" Margin="24,0,24,8" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Leere Felder, „(geerbt …)“ und ■ übernehmen den Wert des übergeordneten Ordners." />

        <DockPanel DockPanel.Dock="Bottom" Margin="24,8,24,20">
            <TextBlock x:Name="ErrorText" Foreground="#E81123" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="330" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Abbrechen" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <ui:Button Content="Speichern" Appearance="Primary" IsDefault="True" MinWidth="110" Click="OnSave" />
            </StackPanel>
        </DockPanel>

        <TabControl Margin="16,0">
            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,8">
                        <TextBlock Style="{StaticResource Label}" Text="Name" />
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Visibility="{Binding IsConnection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Label}" Text="Hostname / IP-Adresse" />
                            <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Protokoll" />
                                <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding Protocol}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Port" />
                                <ui:TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding PortPlaceholder}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Label}" Text="Beschreibung" />
                        <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding DescriptionPlaceholder}" />
                        <TextBlock Style="{StaticResource Label}" Text="Tags (werden in der Schnellsuche gefunden, z. B. „prod, linux, dmz“)" />
                        <ui:TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding TagsPlaceholder}" />
                        <CheckBox Content="Favorit (oben in der Schnellsuche)" IsChecked="{Binding Favorite}" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Anmeldung">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,8">
                        <TextBlock Style="{StaticResource Label}" Text="Zugangsdaten aus dem Vault" />
                        <ComboBox ItemsSource="{Binding CredentialOptions}" SelectedItem="{Binding Credential}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Ein Vault-Eintrag hat Vorrang vor den Feldern unten. Am Ordner gesetzt, gilt er für alle Verbindungen darin." />
                        <TextBlock Style="{StaticResource Label}" Text="Benutzername" />
                        <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding UsernamePlaceholder}" />
                        <TextBlock Style="{StaticResource Label}" Text="Domäne" />
                        <ui:TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding DomainPlaceholder}" />
                        <TextBlock Style="{StaticResource Label}" Text="Passwort" />
                        <CheckBox Content="Passwort vom Ordner erben" IsThreeState="False" IsChecked="{Binding InheritPassword}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="PasswordInput" IsEnabled="{Binding InheritPassword, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="{Binding PasswordHint}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="RDP">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,8">
                        <Border Background="#33E81123" BorderBrush="#E81123" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0"
                                Visibility="{Binding SecurityWarning, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding SecurityWarning}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Style="{StaticResource Label}" Text="Auflösung" />
                        <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding Resolution}" />
                        <TextBlock Style="{StaticResource Label}" Text="Farbtiefe" />
                        <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding ColorDepth}" />
                        <TextBlock Style="{StaticResource Label}" Text="Server-Zertifikat" />
                        <ComboBox ItemsSource="{Binding AuthLevelOptions}" SelectedItem="{Binding AuthLevel}" />
                        <CheckBox Content="Netzwerkebenen-Authentifizierung (NLA / CredSSP)" IsChecked="{Binding UseCredSsp}" />
                        <CheckBox Content="Restricted Admin (keine Zugangsdaten auf dem Server)" IsChecked="{Binding RestrictedAdmin}" />
                        <CheckBox Content="Mit Konsolensitzung verbinden (/admin)" IsChecked="{Binding ConsoleSession}" />
                        <TextBlock Style="{StaticResource Label}" Text="Umleitungen" FontWeight="SemiBold" />
                        <CheckBox Content="Zwischenablage" IsChecked="{Binding RedirectClipboard}" />
                        <CheckBox Content="Drucker" IsChecked="{Binding RedirectPrinters}" />
                        <CheckBox Content="Windows-Tastenkombinationen an den Server (Alt+Tab, Win)" IsChecked="{Binding RedirectKeys}" />
                        <TextBlock Style="{StaticResource Label}" Text="Laufwerke" />
                        <ComboBox ItemsSource="{Binding DriveOptions}" SelectedItem="{Binding Drives}" />
                        <TextBlock Style="{StaticResource Label}" Text="Audio" />
                        <ComboBox ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding Sound}" />
                        <TextBlock Style="{StaticResource Label}" Text="RD Gateway" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding GatewayUsageOptions}" SelectedItem="{Binding GatewayUsage}" />
                        <ui:TextBox Text="{Binding GatewayHost, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding GatewayHostPlaceholder}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:FluentWindow>
