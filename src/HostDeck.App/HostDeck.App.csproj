<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>HostDeck.App</RootNamespace>
    <AssemblyName>HostDeck</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hostdeck.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HostDeck.Presentation\HostDeck.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\hostdeck.ico" />
  </ItemGroup>
</Project>
