<ui:FluentWindow x:Class="HostDeck.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings" Width="600" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <DockPanel Margin="0,0,0,20">
        <ui:TitleBar DockPanel.Dock="Top" Title="Settings" ShowMinimize="False" ShowMaximize="False" />
        <!-- Viele Abschnitte ⇒ scrollbar, falls der Bildschirm nicht hoch genug ist -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,4,24,0">
            <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Theme" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Terminal font size" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" />
            </Grid>
            <CheckBox Content="Syntax highlighting in the terminal (errors, warnings, IPs)" IsChecked="{Binding Highlighting}" Margin="0,4,0,0" />
            <CheckBox Content="Online status in the tree (TCP check of visible connections)" IsChecked="{Binding ShowReachability}" Margin="0,4,0,0" />

            <TextBlock Text="Behavior" FontWeight="SemiBold" Margin="0,16,0,6" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Quick connect default protocol" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Protocols}" SelectedItem="{Binding DefaultProtocol}" ItemTemplate="{StaticResource EnumDisplayTemplate}" />
            </Grid>
            <CheckBox Content="Restore open sessions on startup" IsChecked="{Binding RestoreWorkspace}" Margin="0,4,0,0" />
            <CheckBox Content="SFTP browser follows the terminal directory" IsChecked="{Binding SftpFollows}" Margin="0,4,0,0" />
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="mRemoteNG import: credentials" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ExtractionModes}" SelectedItem="{Binding CredentialExtraction}" ItemTemplate="{StaticResource EnumDisplayTemplate}"
                          ToolTip="How logins from imported mRemoteNG files are stored" />
            </Grid>

            <TextBlock Text="Team library" FontWeight="SemiBold" Margin="0,16,0,6" />
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Browse …" Margin="8,0,0,0" Click="OnBrowseTeamLibrary" />
                <ui:TextBox Text="{Binding TeamLibraryPath, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="\\server\team\confCons.xml  ·  Jumphost: C:\HostDeck\Team" />
            </DockPanel>
            <CheckBox Content="Read-only (e.g. jump host with a local copy)" IsChecked="{Binding TeamReadOnly}" Margin="0,6,0,0" />
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Shared confCons.xml (stays compatible with mRemoteNG). Changes by others appear automatically, save your own with Ctrl+S. Folder instead of file: the newest .xml in it is used." />

            <TextBlock Text="Personal backups" FontWeight="SemiBold" Margin="0,16,0,2" />
            <TextBlock Margin="0,0,0,6" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Your own HostDeck database: personal folders and connections, vault, personal snippets and settings for team entries. The team library keeps its own version history (last 10 versions before each save)." />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Restore …" Margin="0,0,6,0" Click="OnRestoreBackup" />
                    <ui:Button Content="Open folder" Margin="0,0,6,0" Click="OnOpenBackupFolder" />
                    <ui:Button Content="Back up now" Click="OnBackupNow" />
                </StackPanel>
                <ui:ToggleSwitch Content="Create personal backups automatically (daily)" IsChecked="{Binding AutoBackup}" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <ui:Button DockPanel.Dock="Right" Content="Browse …" Margin="8,0,0,0" Click="OnBrowseBackupFolder" />
                <ui:TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding BackupFolderHint}" />
            </DockPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" /><ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" /><ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Keep daily" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DailyOptions}" SelectedItem="{Binding KeepDaily}" />
                <TextBlock Grid.Column="3" Text="weekly" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding WeeklyOptions}" SelectedItem="{Binding KeepWeekly}" />
                <TextBlock Grid.Column="6" Text="monthly" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="7" ItemsSource="{Binding MonthlyOptions}" SelectedItem="{Binding KeepMonthly}" />
            </Grid>
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="Grandfather-father-son retention: HostDeck keeps the newest backup of each of the last days, weeks and months shown above and deletes older automatic backups. The newest backup is always kept. Backups are encrypted copies (database + key file) and open with the master password valid at backup time. Tip: choose a folder on another drive, a network share or OneDrive. " />
                <Run Text="{Binding BackupSummary, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,16,0,6" />
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Check for updates now" Click="OnCheckForUpdates" VerticalAlignment="Center" />
                <ui:ToggleSwitch Content="Install updates automatically" IsChecked="{Binding AutoUpdate}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="When on, HostDeck checks once a day, downloads new versions in the background and installs them when you close the app – never during a session. " />
                <Run Text="{Binding LastUpdateCheckText, Mode=OneWay}" />
            </TextBlock>
            <Expander Header="Advanced: update source and access token" Margin="0,8,0,0">
                <StackPanel Margin="0,6,0,0">
                    <ui:TextBox Text="{Binding UpdateSource, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="https://github.com/…  ·  \\server\software\HostDeck  ·  https://…" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Default: the HostDeck GitHub repository. A network share or HTTPS folder with the release files works as well." />
                    <ui:PasswordBox x:Name="TokenBox" Margin="0,8,0,0" PlaceholderText="{Binding UpdateTokenHint}" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Only for a private GitHub repository: GitHub → Settings → Developer settings → Fine-grained tokens, only this repository, permission “Contents: Read-only”. Stored encrypted in the HostDeck database." />
                </StackPanel>
            </Expander>

            <DockPanel Margin="0,20,0,0">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="HostDeck " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <ui:Button Content="Save" Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOk" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>