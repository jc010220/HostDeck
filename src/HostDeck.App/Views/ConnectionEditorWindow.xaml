<ui:FluentWindow x:Class="HostDeck.App.Views.ConnectionEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Properties" Width="640" Height="660" MinHeight="480"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="IsThreeState" Value="True" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="ToolTip" Value="Three states: on / off / ■ inherited" />
        </Style>
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Properties" ShowMinimize="False" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="24,0,24,4" TextTrimming="CharacterEllipsis" />
        <TextBlock DockPanel.Dock="Top" Margin="24,0,24,8" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Empty fields, “(inherited …)” and ■ take the value of the parent folder." />

        <DockPanel DockPanel.Dock="Bottom" Margin="24,8,24,20">
            <TextBlock x:Name="ErrorText" Foreground="#E81123" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="330" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <ui:Button Content="Save" Appearance="Primary" IsDefault="True" MinWidth="110" Click="OnSave" />
            </StackPanel>
        </DockPanel>

        <TabControl Margin="16,0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,8">
                        <TextBlock Style="{StaticResource Label}" Text="Name" />
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Visibility="{Binding IsConnection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Label}" Text="Hostname / IP address" />
                            <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <Grid Visibility="{Binding IsConnection, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Protocol" />
                                <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding Protocol}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Port" />
                                <ui:TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding PortPlaceholder}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Label}" Text="Description" />
                        <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding DescriptionPlaceholder}" />
                        <TextBlock Style="{StaticResource Label}" Text="Tags (found by quick search, e.g. “prod, linux, dmz”)" />
                        <ui:TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding TagsPlaceholder}" />
                        <CheckBox Content="Favorite (shown first in quick search)" IsChecked="{Binding IsFavorite}" Margin="0,14,0,0" />
                        <!-- Ordner: weitere (meist aus mRemoteNG übernommene) vererbte Werte anzeigen und entfernen -->
                        <Border Margin="0,16,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Visibility="{Binding HiddenFolderValues, Converter={StaticResource NullToVisibility}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding ClearHiddenFolderValuesCommand}" />
                                <TextBlock Text="{Binding HiddenFolderValues}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Login">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,8">
                        <TextBlock Style="{StaticResource Label}" Text="Credentials from the vault" />
                        <ComboBox ItemsSource="{Binding CredentialOptions}" SelectedItem="{Binding Credential}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding CredentialHint}" />
                        <StackPanel Visibility="{Binding IsConnection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Label}" Text="Username" />
                        <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding UsernamePlaceholder}" />
                        <TextBlock Style="{StaticResource Label}" Text="Domain" />
                        <ui:TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding DomainPlaceholder}" />
                        <TextBlock Style="{StaticResource Label}" Text="Password" />
                        <CheckBox Content="Inherit password from folder" IsThreeState="False" IsChecked="{Binding InheritPassword}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="PasswordInput" IsEnabled="{Binding InheritPassword, Converter={StaticResource InverseBool}}" />
                        <CheckBox Content="Delete stored password" IsChecked="{Binding ClearPassword}" Margin="0,6,0,0"
                                  Visibility="{Binding CanClearPassword, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PasswordHint}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="RDP" Visibility="{Binding ShowRdpTab, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,8">
                        <Border Background="#33E81123" BorderBrush="#E81123" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0"
                                Visibility="{Binding SecurityWarning, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding SecurityWarning}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Style="{StaticResource Label}" Text="Resolution" />
                        <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding Resolution}" />
                        <StackPanel Visibility="{Binding IsConnection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Label}" Text="Color depth" />
                        <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding ColorDepth}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Server certificate" />
                        <ComboBox ItemsSource="{Binding AuthLevelOptions}" SelectedItem="{Binding AuthLevel}" />
                        <StackPanel Visibility="{Binding IsConnection, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Network Level Authentication (NLA / CredSSP)" IsChecked="{Binding IsCredSsp}" />
                        <CheckBox Content="Restricted Admin (no credentials on the server)" IsChecked="{Binding IsRestrictedAdmin}" />
                        <CheckBox Content="Connect to console session (/admin)" IsChecked="{Binding IsConsoleSession}" />
                        <TextBlock Style="{StaticResource Label}" Text="Redirection" FontWeight="SemiBold" />
                        <CheckBox Content="Clipboard" IsChecked="{Binding IsRedirectClipboard}" />
                        <CheckBox Content="Printers" IsChecked="{Binding IsRedirectPrinters}" />
                        <CheckBox Content="Send Windows key combinations to the server (Alt+Tab, Win)" IsChecked="{Binding IsRedirectKeys}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Drives" />
                        <ComboBox ItemsSource="{Binding DriveOptions}" SelectedItem="{Binding Drives}" />
                        <StackPanel Visibility="{Binding IsConnection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Label}" Text="Audio" />
                        <ComboBox ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding Sound}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="RD Gateway" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding GatewayUsageOptions}" SelectedItem="{Binding GatewayUsage}" />
                        <ui:TextBox Text="{Binding GatewayHost, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding GatewayHostPlaceholder}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:FluentWindow>
