<ui:FluentWindow x:Class="HostDeck.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Einstellungen" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel Margin="0,0,0,20">
        <ui:TitleBar Title="Einstellungen" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,4,24,0">
            <TextBlock Text="Darstellung" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Farbschema" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Terminal-Schriftgröße" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" />
            </Grid>
            <CheckBox Content="Syntax-Highlighting im Terminal (Fehler, Warnungen, IPs)" IsChecked="{Binding Highlighting}" Margin="0,4,0,0" />
            <CheckBox Content="Online-Status im Baum (TCP-Test sichtbarer Verbindungen)" IsChecked="{Binding ShowReachability}" Margin="0,4,0,0" />

            <TextBlock Text="Verhalten" FontWeight="SemiBold" Margin="0,16,0,6" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Quick-Connect ohne Protokoll" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Protocols}" SelectedItem="{Binding DefaultProtocol}" />
            </Grid>
            <CheckBox Content="Offene Sessions beim Start wiederherstellen" IsChecked="{Binding RestoreWorkspace}" Margin="0,4,0,0" />
            <CheckBox Content="SFTP-Browser folgt dem Terminal-Verzeichnis" IsChecked="{Binding SftpFollows}" Margin="0,4,0,0" />
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="mRemoteNG-Import: Zugangsdaten" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ExtractionModes}" SelectedItem="{Binding CredentialExtraction}"
                          ToolTip="SharedOnly: mehrfach verwendete Logins werden zu Vault-Einträgen" />
            </Grid>

            <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,16,0,6" />
            <ui:TextBox Text="{Binding UpdateSource, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="\\server\software\HostDeck  ·  https://…  ·  https://github.com/…" />
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Updates werden im Hintergrund geladen und beim Beenden installiert (nur bei Installation über Setup.exe)." />
            <ui:PasswordBox x:Name="TokenBox" Margin="0,8,0,0" PlaceholderText="{Binding UpdateTokenHint}" />
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="GitHub → Settings → Developer settings → Fine-grained tokens: nur dieses Repository, Berechtigung „Contents: Read-only“. Wird verschlüsselt in der HostDeck-Datenbank gespeichert." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Abbrechen" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <ui:Button Content="Speichern" Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
