<Application x:Class="HostDeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:HostDeck.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:ProtocolIconConverter x:Key="ProtocolIcon" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:ThemeIconConverter x:Key="ThemeIcon" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:FileSizeConverter x:Key="FileSize" />
            <conv:InverseBoolConverter x:Key="InverseBool" />

            <!-- Monospace für Hosts/Terminals: Cascadia (Win11/Terminal), Fallback Consolas -->
            <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
