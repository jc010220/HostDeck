<ui:FluentWindow x:Class="HostDeck.App.Views.MessageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="460" MinHeight="160" SizeToContent="Height" MaxHeight="640"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" ShowInTaskbar="False">
    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False" />
        <!-- Kompakt: Höhe richtet sich nach dem Text; lange Meldungen scrollen. Text bleibt markier-/kopierbar. -->
        <ScrollViewer Grid.Row="1" Margin="24,4,24,20" VerticalScrollBarVisibility="Auto" MaxHeight="480">
            <TextBox x:Name="MessageText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0"
                     Background="Transparent" MinHeight="0" VerticalAlignment="Top" FontSize="14"
                     Style="{x:Null}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </ScrollViewer>
        <ui:Button Grid.Row="2" Content="OK" Appearance="Primary" IsDefault="True" IsCancel="True"
                   HorizontalAlignment="Right" Margin="0,0,24,0" MinWidth="96" Click="OnOk" />
    </Grid>
</ui:FluentWindow>
