<ui:FluentWindow x:Class="HostDeck.App.Views.SnippetDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Snippet" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel Margin="0,0,0,20">
        <ui:TitleBar Title="Snippet" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,4,24,0">
            <TextBlock Text="Name" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" />
            <TextBlock Text="Category (optional)" Margin="0,10,0,4" />
            <TextBox x:Name="CategoryBox" />
            <TextBlock Text="Command – may span multiple lines, placeholders {{Name}} are asked for when run" Margin="0,10,0,4" TextWrapping="Wrap" />
            <TextBox x:Name="CommandBox" AcceptsReturn="True" Height="120" FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto" />
            <CheckBox x:Name="ExecuteBox" Content="Send Enter automatically (run immediately)" Margin="0,10,0,0" IsChecked="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <ui:Button Content="Save" Appearance="Primary" MinWidth="96" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
