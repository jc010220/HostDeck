<ui:FluentWindow x:Class="HostDeck.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:HostDeck.App"
                 xmlns:controls="clr-namespace:HostDeck.App.Controls"
                 xmlns:views="clr-namespace:HostDeck.App.Views"
                 xmlns:vm="clr-namespace:HostDeck.Presentation.ViewModels;assembly=HostDeck.Presentation"
                 xmlns:behaviors="clr-namespace:HostDeck.App.Behaviors"
                 Title="HostDeck" Width="1440" Height="900" MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="HostDeck">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/hostdeck.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="1" Padding="8,2,8,6">
            <DockPanel LastChildFill="False">
                <DockPanel.Resources>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Appearance" Value="Transparent" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                    </Style>
                    <Style TargetType="Separator">
                        <Setter Property="Margin" Value="6,4" />
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DockPanel.Resources>

                <ToggleButton x:Name="SidebarToggle" Click="OnSidebarToggle" IsChecked="True"
                              ToolTip="Show/hide sidebar  (Ctrl+Shift+B)">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Sidebar}" />
                </ToggleButton>
                <Separator />
                <ui:Button Command="{Binding ImportMRemoteNGCommand}" ToolTip="Import mRemoteNG file (confCons.xml)  (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{x:Static app:Icons.Import}" Margin="0,0,6,0" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Command="{Binding ExportMRemoteNGCommand}" ToolTip="Export as mRemoteNG file">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Export}" />
                </ui:Button>
                <Separator />
                <ui:Button Command="{Binding NewConnectionCommand}" ToolTip="New connection  (Ctrl+N)">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Add}" />
                </ui:Button>
                <ui:Button Command="{Binding NewFolderCommand}" ToolTip="New folder  (Ctrl+Shift+N)">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.FolderAdd}" />
                </ui:Button>
                <Separator />

                <!-- Split-Screen -->
                <ToggleButton ToolTip="Single pane  (Ctrl+Alt+1)" Command="{Binding Workspace.SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.Single}"
                              IsChecked="{Binding Workspace.Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Single}">
                    <controls:LayoutGlyph Layout="Single" />
                </ToggleButton>
                <ToggleButton ToolTip="Two panes side by side  (Ctrl+Alt+2)" Command="{Binding Workspace.SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.TwoColumns}"
                              IsChecked="{Binding Workspace.Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=TwoColumns}">
                    <controls:LayoutGlyph Layout="TwoColumns" />
                </ToggleButton>
                <ToggleButton ToolTip="Two panes stacked  (Ctrl+Alt+3)" Command="{Binding Workspace.SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.TwoRows}"
                              IsChecked="{Binding Workspace.Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=TwoRows}">
                    <controls:LayoutGlyph Layout="TwoRows" />
                </ToggleButton>
                <ToggleButton ToolTip="2×2 grid  (Ctrl+Alt+4)" Command="{Binding Workspace.SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.Grid}"
                              IsChecked="{Binding Workspace.Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Grid}">
                    <controls:LayoutGlyph Layout="Grid" />
                </ToggleButton>
                <Separator />
                <ui:Button Command="{Binding SyncTeamCommand}" Visibility="{Binding HasTeamLibrary, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="Sync team library: pull others' changes, save your own  (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{x:Static app:Icons.Sync}" Margin="0,0,6,0" />
                        <TextBlock Text="Team" />
                        <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="7" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding TeamPendingChanges, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="{Binding TeamPendingChanges}" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </ui:Button>
                <ToggleButton IsChecked="{Binding IsMultiExecutionEnabled}"
                              ToolTip="Multi-execution: send input to all terminal tabs  (Ctrl+Shift+M)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{x:Static app:Icons.Keyboard}" Margin="0,0,6,0" />
                        <TextBlock Text="Multi-Exec" />
                    </StackPanel>
                </ToggleButton>

                <ui:Button DockPanel.Dock="Right" Click="OnPaletteButton" ToolTip="Quick search  (Ctrl+K)" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{x:Static app:Icons.Search}" Margin="0,0,6,0" />
                        <TextBlock Text="Search …" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Margin="10,0,0,0" Padding="5,0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Border>
                    </StackPanel>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" ToolTip="Settings &amp; security" Click="OnSecurityMenu">
                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Lock}" />
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Settings …" Command="{Binding OpenSettingsCommand}" />
                            <MenuItem Header="Manage credentials (vault) …" Command="{Binding ManageVaultCommand}" />
                            <MenuItem Header="Change HostDeck master password …" Command="{Binding ChangeMasterPasswordCommand}" />
                            <MenuItem Header="Create backup …" Command="{Binding BackupCommand}" />
                            <MenuItem Header="Remember on this PC (unlock without password)" IsCheckable="True"
                                      IsChecked="{Binding IsDeviceUnlockEnabled}"
                                      Visibility="{Binding DeviceUnlockSupported, Converter={StaticResource BoolToVisibility}}" />
                            <Separator />
                            <MenuItem Header="Connect team library …" Command="{Binding ConnectTeamLibraryCommand}" />
                            <MenuItem Header="Sync team library" InputGestureText="Ctrl+S" Command="{Binding SyncTeamCommand}"
                                      Visibility="{Binding HasTeamLibrary, Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Header="Set team file password …" Command="{Binding SetTeamPasswordCommand}"
                                      Visibility="{Binding HasTeamLibrary, Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Header="Disconnect team library" Command="{Binding DisconnectTeamLibraryCommand}"
                                      Visibility="{Binding HasTeamLibrary, Converter={StaticResource BoolToVisibility}}" />
                            <Separator />
                            <MenuItem Header="{Binding StoreLocation}" HeaderStringFormat="Database: {0}" IsEnabled="False" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
                <ui:Button DockPanel.Dock="Right" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToolTip}">
                    <ui:SymbolIcon Symbol="{Binding CurrentTheme, Converter={StaticResource ThemeIcon}}" />
                </ui:Button>
            </DockPanel>
        </Border>

        <!-- ===== Hauptbereich ===== -->
        <Grid Grid.Row="2" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="200" MaxWidth="700" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Seitenleiste -->
            <Border x:Name="SidebarPanel" CornerRadius="6" Padding="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
              <TabControl x:Name="SidebarTabs" Background="Transparent" BorderThickness="0" Padding="0,6,0,0">
                <TabItem Header="Sessions">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <!-- Protokoll für Quick-Connect: Auto = Standard aus den Einstellungen bzw. am Port erkannt -->
                        <ComboBox DockPanel.Dock="Left" Width="92" Margin="0,0,6,0"
                                  ItemsSource="{Binding QuickConnectProtocols}" SelectedItem="{Binding QuickConnectProtocol}"
                                  DisplayMemberPath="Label"
                                  ToolTip="Protocol for quick connect. Auto: from the input (rdp …, ssh …), a known port (:3389 = RDP, :22 = SSH, :5900 = VNC …) or the default in the settings." />
                        <ComboBox x:Name="QuickConnectBox" IsEditable="True"
                                  Text="{Binding QuickConnectText, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding QuickConnectHistory}" PreviewKeyDown="OnQuickConnectKeyDown"
                                  ToolTip="Quick connect: ssh user@host:22 · rdp server · mstsc /v:host · telnet host 23 · host:3389 · name from the list  (Ctrl+L)" />
                    </DockPanel>

                    <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6" PlaceholderText="Search …  (Ctrl+F)"
                                Text="{Binding SessionTree.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                ClearButtonEnabled="True" PreviewKeyDown="OnSearchKeyDown">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="{x:Static app:Icons.Search}" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <TextBlock DockPanel.Dock="Bottom" Margin="4,6,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <Run Text="{Binding SessionTree.VisibleConnectionCount, Mode=OneWay}" /><Run Text=" connections" />
                    </TextBlock>

                    <TreeView x:Name="SessionTreeView" ItemsSource="{Binding SessionTree.Items}"
                              behaviors:TreeDragDrop.ViewModel="{Binding SessionTree}"
                              SelectedItemChanged="OnTreeSelectedItemChanged" MouseDoubleClick="OnTreeDoubleClick"
                              KeyDown="OnTreeKeyDown" MouseLeftButtonDown="OnTreeEmptyAreaClick" Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                                <Setter Property="ToolTip" Value="{Binding Subtitle}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Connect" InputGestureText="Enter" Click="OnMenuOpen" FontWeight="SemiBold" />
                                <MenuItem Header="Open all in split view" Click="OnMenuOpenTiled" />
                                <Separator />
                                <MenuItem Header="New connection" InputGestureText="Ctrl+N" Command="{Binding NewConnectionCommand}" />
                                <MenuItem Header="New folder" InputGestureText="Ctrl+Shift+N" Command="{Binding NewFolderCommand}" />
                                <MenuItem Header="New personal folder (top level, only for me)" Command="{Binding NewPersonalFolderCommand}" />
                                <Separator />
                                <MenuItem Header="Properties …" InputGestureText="F4" Click="OnMenuEdit" />
                                <MenuItem Header="Rename" InputGestureText="F2" Click="OnMenuRename" />
                                <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Click="OnMenuDuplicate" />
                                <MenuItem Header="Delete" InputGestureText="Del" Click="OnMenuDelete" />
                                <Separator />
                                <MenuItem Header="Manage credentials (vault) …" Command="{Binding ManageVaultCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <ui:SymbolIcon FontSize="16" Margin="0,0,8,0">
                                        <ui:SymbolIcon.Symbol>
                                            <MultiBinding Converter="{StaticResource ProtocolIcon}">
                                                <Binding />
                                                <Binding Path="IsExpanded" />
                                                <Binding Path="Protocol" />
                                            </MultiBinding>
                                        </ui:SymbolIcon.Symbol>
                                    </ui:SymbolIcon>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="7,1,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Reachability}" Value="Online">
                                        <Setter TargetName="StatusDot" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#16C60C" />
                                        <Setter TargetName="StatusDot" Property="ToolTip" Value="Reachable" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Reachability}" Value="Offline">
                                        <Setter TargetName="StatusDot" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#E81123" />
                                        <Setter TargetName="StatusDot" Property="ToolTip" Value="Not reachable (port does not respond)" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
                </TabItem>

                <!-- ===== SFTP-Browser des aktiven SSH-Tabs ===== -->
                <TabItem Header="SFTP">
                    <Grid>
                        <TextBlock Margin="8,24" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Open an SSH session – the file browser then automatically follows the terminal's current directory."
                                   Visibility="{Binding ActiveSftp, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                        <DockPanel DataContext="{Binding ActiveSftp}"
                                   Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                            <!-- Pfadzeile: hoch · Pfad · neuer Ordner · aktualisieren -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <ui:Button DockPanel.Dock="Left" Appearance="Transparent" Padding="6,5" Margin="0,0,2,0" Command="{Binding UpCommand}" ToolTip="Parent folder">
                                    <ui:SymbolIcon Symbol="{x:Static app:Icons.ArrowUp}" />
                                </ui:Button>
                                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="6,5" Margin="2,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                                    <ui:SymbolIcon Symbol="{x:Static app:Icons.Refresh}" />
                                </ui:Button>
                                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="6,5" Margin="2,0,0,0" Command="{Binding NewFolderCommand}" ToolTip="New folder">
                                    <ui:SymbolIcon Symbol="{x:Static app:Icons.FolderAdd}" />
                                </ui:Button>
                                <TextBox x:Name="SftpPath" Text="{Binding Path, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         VerticalContentAlignment="Center" KeyDown="OnSftpPathKeyDown" ToolTip="Enter a path and press Enter" />
                            </DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Top" Margin="4,2,0,8" Content="Follow terminal" IsChecked="{Binding FollowTerminal}"
                                             ToolTip="The folder follows “cd” in the terminal" />
                            <!-- Fußzeile: Übertragung + Status -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="4,6,0,0">
                                <ProgressBar Height="3" Value="{Binding TransferPercent}" Margin="0,0,0,4"
                                             Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <!-- Dateiliste: ListBox (vom Theme gestaltet; ListView wäre im Dark Mode weiß) -->
                            <Border CornerRadius="6" BorderThickness="1" Padding="2"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ListBox x:Name="SftpList" ItemsSource="{Binding Entries}" SelectionMode="Extended" AllowDrop="True"
                                     Background="Transparent" BorderThickness="0"
                                     MouseDoubleClick="OnSftpDoubleClick" Drop="OnSftpDrop" DragOver="OnSftpDragOver"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1" Background="Transparent">
                                            <DockPanel.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak />
                                                    <Run Text="{Binding Permissions, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><LineBreak />
                                                    <Run Text="{Binding LastWriteTime, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                                </TextBlock>
                                            </DockPanel.ToolTip>
                                            <ui:SymbolIcon DockPanel.Dock="Left" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="{x:Static app:Icons.Document}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Symbol" Value="{x:Static app:Icons.Folder}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock x:Name="SizeText" DockPanel.Dock="Right" FontSize="11" Margin="8,0,2,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Size, Converter={StaticResource FileSize}}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter TargetName="SizeText" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open / download (Downloads)" Click="OnSftpOpen" FontWeight="SemiBold" />
                                        <MenuItem Header="Download to …" Click="OnSftpDownload" />
                                        <MenuItem Header="Rename" Click="OnSftpRename" />
                                        <MenuItem Header="Delete" Click="OnSftpDelete" />
                                        <Separator />
                                        <MenuItem Header="Upload files …" Click="OnSftpUpload" />
                                        <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            </Border>
                        </DockPanel>
                    </Grid>
                </TabItem>
                <!-- ===== Snippets / Makros ===== -->
                <TabItem Header="Snippets">
                    <DockPanel DataContext="{Binding Snippets}">
                        <ui:TextBox DockPanel.Dock="Top" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter snippets …" Margin="0,0,0,6" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:Button Click="OnSnippetAdd" Appearance="Transparent" Padding="6,4" ToolTip="New snippet">
                                <ui:SymbolIcon Symbol="{x:Static app:Icons.Add}" />
                            </ui:Button>
                            <ui:Button Click="OnSnippetEdit" Appearance="Transparent" Padding="6,4" ToolTip="Edit">
                                <ui:SymbolIcon Symbol="{x:Static app:Icons.Edit}" />
                            </ui:Button>
                            <ui:Button Click="OnSnippetDelete" Appearance="Transparent" Padding="6,4" ToolTip="Delete">
                                <ui:SymbolIcon Symbol="{x:Static app:Icons.Delete}" />
                            </ui:Button>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" MaxWidth="170"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Double-click sends to the active terminal (multi-exec: to all)" />
                        </StackPanel>
                        <ListBox x:Name="SnippetList" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}"
                                 MouseDoubleClick="OnSnippetRun" KeyDown="OnSnippetKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2" ToolTip="{Binding Command}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontSize="10" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Border x:Name="TeamBadge" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,0" CornerRadius="3"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"
                                                    ToolTip="Shared with the team (team library)">
                                                <TextBlock Text="Team" FontSize="10" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Command}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTeam}" Value="True">
                                            <Setter TargetName="TeamBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
              </TabControl>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                          DragCompleted="OnSidebarResized" />

            <!-- Arbeitsbereich: Tabs + Split-Screen -->
            <views:SplitWorkspace x:Name="Workspace" Grid.Column="2" Workspace="{Binding Workspace}" />
        </Grid>

        <!-- ===== Statusleiste ===== -->
        <DockPanel Grid.Row="3" Margin="12,4,12,6">
            <!-- Version ganz rechts; Klick prüft auf Updates -->
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="6,0" Margin="8,0,0,0" FontSize="11" BorderThickness="0"
                       Command="{Binding CheckForUpdatesCommand}" ToolTip="HostDeck version – click to check for updates">
                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="v" /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
            </ui:Button>
            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{Binding Workspace.TabCount, Mode=OneWay}" /><Run Text=" session(s)" />
            </TextBlock>
            <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="14" Height="14" Margin="0,0,12,0"
                             Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" ToolTip="Import running …" />
            <ui:Button DockPanel.Dock="Right" Margin="0,0,12,0" Padding="10,2" FontSize="12"
                       Command="{Binding Workspace.ActiveTab.CancelConnectCommand}"
                       Visibility="{Binding Workspace.ActiveTab.IsConnecting, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                       ToolTip="Cancel connecting the active tab (in the terminal: Esc)">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12" Margin="0,0,8,0" />
                    <TextBlock Text="Connecting … Cancel" />
                </StackPanel>
            </ui:Button>
            <Border DockPanel.Dock="Right" Margin="0,0,12,0" Padding="8,0" CornerRadius="4"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="{Binding IsMultiExecutionEnabled, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="MULTI-EXEC ON" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" Text="{Binding TeamStatus}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
