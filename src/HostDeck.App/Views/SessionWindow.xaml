<ui:FluentWindow x:Class="HostDeck.App.Views.SessionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:HostDeck.App"
                 xmlns:controls="clr-namespace:HostDeck.App.Controls"
                 xmlns:views="clr-namespace:HostDeck.App.Views"
                 xmlns:vm="clr-namespace:HostDeck.Presentation.ViewModels;assembly=HostDeck.Presentation"
                 Title="HostDeck" Width="1100" Height="720" MinWidth="500" MinHeight="320"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round" UseLayoutRounding="True">
    <DockPanel>
        <ui:TitleBar x:Name="TitleBar" DockPanel.Dock="Top" Title="HostDeck">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/hostdeck.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,6">
            <StackPanel.Resources>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="Margin" Value="0,0,2,0" />
                </Style>
            </StackPanel.Resources>
            <ToggleButton ToolTip="Ein Bereich" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.Single}"
                          IsChecked="{Binding Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Single}">
                <controls:LayoutGlyph Layout="Single" />
            </ToggleButton>
            <ToggleButton ToolTip="Zwei nebeneinander" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.TwoColumns}"
                          IsChecked="{Binding Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=TwoColumns}">
                <controls:LayoutGlyph Layout="TwoColumns" />
            </ToggleButton>
            <ToggleButton ToolTip="Zwei untereinander" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.TwoRows}"
                          IsChecked="{Binding Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=TwoRows}">
                <controls:LayoutGlyph Layout="TwoRows" />
            </ToggleButton>
            <ToggleButton ToolTip="4er-Grid" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:WorkspaceLayout.Grid}"
                          IsChecked="{Binding Layout, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Grid}">
                <controls:LayoutGlyph Layout="Grid" />
            </ToggleButton>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Schließen holt die Sessions ins Hauptfenster zurück · Tabs per Drag &amp; Drop zwischen Fenstern verschieben" />
        </StackPanel>
        <views:SplitWorkspace x:Name="Workspace" Margin="8,0,8,8" Workspace="{Binding}" />
    </DockPanel>
</ui:FluentWindow>
